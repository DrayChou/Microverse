{
  "runtime": {
    "save": {
      "system": {
        "auto_save": {
          "enabled": true,
          "interval_minutes": 5,
          "max_auto_saves": 10,
          "save_on_quit": true
        },
        "quick_save": {
          "enabled": true,
          "max_quick_saves": 5,
          "key_binding": "F5"
        },
        "manual_save": {
          "enabled": true,
          "max_manual_saves": 50,
          "compression": true,
          "encryption": false
        },
        "backup": {
          "enabled": true,
          "backup_count": 3,
          "backup_on_major_events": true,
          "backup_location": "user://saves/backups/"
        },
        "data_structure": {
          "version": "1.0",
          "metadata": {
            "timestamp": true,
            "playtime": true,
            "screenshot": true,
            "checksum": true
          },
          "game_state": {
            "player_position": true,
            "character_states": true,
            "inventory": true,
            "quest_progress": true,
            "world_state": true
          }
        },
        "file_format": {
          "format": "json",
          "compression": "gzip",
          "encryption": false
        }
      }
    }
  }
}