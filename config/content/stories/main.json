            "objectives": [
              {
                "id": "attend_meeting",
                "description": "参加项目启动会议",
                "required": true
              },
              {
                "id": "complete_tasks",
                "description": "完成分配的开发任务",
                "required": true
              },
              {
                "id": "pass_testing",
                "description": "通过测试验证",
                "required": true
              }
            ]
          },
          {
            "id": "chapter_3",
            "title": "危机时刻",
            "description": "项目遇到技术难题",
