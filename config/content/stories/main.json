                "triggers": ["introduction"]
              },
              {
                "scene": "office",
                "description": "参观办公室，认识同事",
                "key_characters": ["stephen", "alice", "tom"],
                "triggers": ["meet_colleagues"]
              }
            ],
            "objectives": [
              {
                "id": "meet_stephen",
                "description": "与老板史蒂芬见面",
                "required": true
              },
              {
                "id": "meet_team",
                "description": "认识团队成员",
                "required": true
              },
              {
                "id": "setup_desk",
                "description": "布置自己的工位",
                "required": false
              }
            ]
          },
          {
            "id": "chapter_2",
            "title": "第一个项目",
            "description": "参与第一个重要项目",
            "duration": "4-5小时",
            "scenes": [
              {
                "scene": "meeting_room",
